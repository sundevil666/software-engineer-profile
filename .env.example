# Optional absolute Chrome/Chromium path for local PDF generation.
# macOS uses the standard Google Chrome path automatically.
CHROME_PATH=

# Optional JSON ranking configuration for choosing projects in the PDF.
# When omitted, the first five public projects are selected safely.
# Keep private scoring decisions in a local .env or .private file.
RESUME_PROJECT_RANKING=

# Optional production origin used by the PDF renderer on serverless hosts.
# VERCEL_URL is detected automatically when available.
PUBLIC_SITE_URL=
