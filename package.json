{
  "name": "software-engineer-profile",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "nuxt build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "nuxt dev",
    "lint": "eslint .",
    "postinstall": "nuxt prepare",
    "prepare": "simple-git-hooks",
    "test": "vitest run",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@sparticuz/chromium": "149.0.0",
    "nuxt": "3.21.8",
    "playwright-core": "1.61.1",
    "vue": "3.5.40",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.16.0",
    "@types/node": "24.10.1",
    "eslint": "10.7.0",
    "sass": "1.101.0",
    "simple-git-hooks": "2.13.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.7"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@nuxt/schema": "3.21.8"
      }
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check"
  }
}
